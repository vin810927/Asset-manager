# Cloudflare Pages Functions runtime variables.
# Fill these in Cloudflare Pages dashboard, not in front-end code.
#
# ACCESS_TEAM_DOMAIN example:
# https://<team-name>.cloudflareaccess.com
#
# ACCESS_AUD comes from:
# Zero Trust -> Access controls -> Applications -> asset-agent -> Additional settings -> Application Audience (AUD) Tag
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Local-only Pages Functions E2E helper.
# Keep false in tracked files and Cloudflare environments.
# In local .dev.vars only, set LOCAL_DEV_AUTH=true to use a fixed localhost identity.
LOCAL_DEV_AUTH=false

# AI narrative report is generated by a Cloudflare Pages Function.
# Set these only in Cloudflare Pages environment variables; never in front-end code.
# Keep OPENAI_API_KEY in Cloudflare, but leave ENABLE_AI_REPORT=false unless intentionally using API credits.
ENABLE_AI_REPORT=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Manual market data update preview.
# Default disabled; keep false unless intentionally testing provider usage.
# VITE_ENABLE_MARKET_DATA_UPDATE controls front-end visibility.
# ENABLE_MARKET_DATA_UPDATE controls Pages Function provider access.
VITE_ENABLE_MARKET_DATA_UPDATE=false
ENABLE_MARKET_DATA_UPDATE=false
MARKET_DATA_PROVIDER=alpha_vantage
MARKET_DATA_API_KEY=
EXCHANGE_RATE_API_KEY=
